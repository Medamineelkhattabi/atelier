# Copy to .env (never committed). Every value is optional.
#
# AI access: this platform uses only your Claude subscription, through Claude Code.
# There is nothing to configure here for it: sign in once with `pae claude-login`
# (Docker: `docker compose exec -it pae pae claude-login`). API keys and other
# provider credentials are removed from the environment at startup, by design.

# One-time token for creating the owner account (otherwise one is printed in the log).
PAE_SETUP_TOKEN=

# Docker only: host directory mounted at /workspaces for agents to work in.
PAE_WORKSPACES_HOST_DIR=./data/workspaces
